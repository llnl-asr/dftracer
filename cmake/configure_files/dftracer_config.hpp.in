#ifndef DFTRACER_CONFIG_HPP
#define DFTRACER_CONFIG_HPP
// clang-format off
/* Version string for DFTRACER */
#define DFTRACER_PACKAGE_VERSION "@DFTRACER_PACKAGE_VERSION@"
#cmakedefine DFTRACER_GIT_VERSION "@DFTRACER_GIT_VERSION@"
#define DFTRACER_GET_VERSION(MAJOR, MINOR, PATCH) (MAJOR * 10000 + MINOR * 100 + PATCH)
#define DFTRACER_VERSION DFTRACER_GET_VERSION(@DFTRACER_PACKAGE_VERSION_MAJOR@, @DFTRACER_PACKAGE_VERSION_MINOR@, @DFTRACER_PACKAGE_VERSION_PATCH@)
#define DFTRACER_VERSION_MAJOR (DFTRACER_VERSION / 100000)
#define DFTRACER_VERSION_MINOR ((DFTRACER_VERSION / 100) % 1000)
#define DFTRACER_VERSION_PATCH (DFTRACER_VERSION % 100)

/* rocprofiler-sdk version in numeric MAJOR.MINOR.PATCH format */
#define DFTRACER_ROCPROFILER_VERSION_MAJOR @DFTRACER_ROCPROFILER_VERSION_MAJOR@
#define DFTRACER_ROCPROFILER_VERSION_MINOR @DFTRACER_ROCPROFILER_VERSION_MINOR@
#define DFTRACER_ROCPROFILER_VERSION_PATCH @DFTRACER_ROCPROFILER_VERSION_PATCH@
#define DFTRACER_ROCPROFILER_VERSION \
    DFTRACER_GET_VERSION(DFTRACER_ROCPROFILER_VERSION_MAJOR, DFTRACER_ROCPROFILER_VERSION_MINOR, DFTRACER_ROCPROFILER_VERSION_PATCH)

/* CUDA toolkit version in numeric MAJOR.MINOR.PATCH format. Used by the CUPTI
 * backend to pick the right versioned CUpti_Activity* record structs, which
 * NVIDIA renumbers and eventually removes across toolkit releases. */
#define DFTRACER_CUDA_VERSION_MAJOR @DFTRACER_CUDA_VERSION_MAJOR@
#define DFTRACER_CUDA_VERSION_MINOR @DFTRACER_CUDA_VERSION_MINOR@
#define DFTRACER_CUDA_VERSION_PATCH @DFTRACER_CUDA_VERSION_PATCH@
#define DFTRACER_CUDA_VERSION \
    DFTRACER_GET_VERSION(DFTRACER_CUDA_VERSION_MAJOR, DFTRACER_CUDA_VERSION_MINOR, DFTRACER_CUDA_VERSION_PATCH)

/* Compiler used */
#cmakedefine DFTRACER_CMAKE_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

#cmakedefine DFTRACER_CMAKE_C_COMPILER "@CMAKE_C_COMPILER@"
#cmakedefine DFTRACER_CMAKE_C_FLAGS "@CMAKE_C_FLAGS@"
#cmakedefine DFTRACER_CMAKE_C_FLAGS_DEBUG "@CMAKE_C_FLAGS_DEBUG@"
#cmakedefine DFTRACER_CMAKE_C_FLAGS_RELWITHDEBINFO "@CMAKE_C_FLAGS_RELWITHDEBINFO@"
#cmakedefine DFTRACER_CMAKE_C_FLAGS_RELEASE "@CMAKE_C_FLAGS@_RELEASE"

#cmakedefine DFTRACER_CMAKE_CXX_COMPILER "@CMAKE_CXX_COMPILER@"
#cmakedefine DFTRACER_CMAKE_CXX_FLAGS "@CMAKE_CXX_FLAGS@"
#cmakedefine DFTRACER_CMAKE_CXX_FLAGS_DEBUG "@CMAKE_CXX_FLAGS_DEBUG@"
#cmakedefine DFTRACER_CMAKE_CXX_FLAGS_RELWITHDEBINFO "@CMAKE_CXX_FLAGS_RELWITHDEBINFO@"
#cmakedefine DFTRACER_CMAKE_CXX_FLAGS_RELEASE "@CMAKE_CXX_FLAGS_RELEASE@"

#cmakedefine DFTRACER_CMAKE_C_SHARED_LIBRARY_FLAGS "@CMAKE_C_SHARED_LIBRARY_FLAGS@"
#cmakedefine DFTRACER_CMAKE_CXX_SHARED_LIBRARY_FLAGS "@CMAKE_CXX_SHARED_LIBRARY_FLAGS@"

/* Real path of libc's shared object, resolved via the compiler. Used by
 * dftracer::STDIOBypass/POSIXBypass to dlopen(..., RTLD_NOLOAD) + dlsym()
 * real libc I/O functions directly, bypassing GOTCHA's PLT/GOT rewriting. */
#cmakedefine DFTRACER_LIBC_SO_PATH "@DFTRACER_LIBC_SO_PATH@"

/* Macro flags */
#cmakedefine DFTRACER_GNU_LINUX 1
#cmakedefine DFTRACER_MPI_ENABLE 1
// MPI implementation name string (OPENMPI, MPICH, CRAYMPICH, MVAPICH, INTELMPI, UNKNOWN)
#cmakedefine DFTRACER_MPI_IMPL_NAME "@DFTRACER_MPI_IMPL_NAME@"
#cmakedefine DFTRACER_HDF5_ENABLE 1
#cmakedefine DFTRACER_FTRACING_ENABLE 1
#cmakedefine DFTRACER_HWLOC_ENABLE 1
#cmakedefine DFTRACER_HIP_TRACING_ENABLE 1
#cmakedefine DFTRACER_PAPI_TRACING_ENABLE 1

// Set when the build found (or built) variorum, so the service's power
// collector can call it. Node power is read in the service, not in a traced
// process, so this only affects dftracer_service.
#cmakedefine DFTRACER_VARIORUM_ENABLE 1

// Every PAPI counter this machine can program, found by
// cmake/probes/papi_probe.c at build time. Used as the runtime default so a run
// does not have to rediscover them; DFTRACER_PAPI_EVENTS still overrides.
// HW_COUNTERS is the number of hardware slots and FITTING_COUNTERS how many of
// the detected counters fit at once; when fewer fit than were detected,
// DFTracer multiplexes so all of them are still collected. Both are 0 when the
// probe could not run.
#define DFTRACER_PAPI_DETECTED_EVENTS "@DFTRACER_PAPI_DETECTED_EVENTS@"
#define DFTRACER_PAPI_HW_COUNTERS @DFTRACER_PAPI_HW_COUNTERS@
#define DFTRACER_PAPI_FITTING_COUNTERS @DFTRACER_PAPI_FITTING_COUNTERS@
#cmakedefine DFTRACER_CUDA_TRACING_ENABLE 1

//==========================
// Common macro definitions
//==========================

#define DFTRACER_PATH_DELIM "/"

// Detect VAR_OPT
// https://stackoverflow.com/questions/48045470/portably-detect-va-opt-support
#if __cplusplus <= 201703 && defined __GNUC__ && !defined __clang__ && \
    !defined __EDG__
#define VA_OPT_SUPPORTED false
#else
#define PP_THIRD_ARG(a, b, c, ...) c
#define VA_OPT_SUPPORTED_I(...) PP_THIRD_ARG(__VA_OPT__(, ), true, false, )
#define VA_OPT_SUPPORTED VA_OPT_SUPPORTED_I(?)
#endif

#if !defined(DFTRACER_HASH_SEED) || (DFTRACER_HASH_SEED <= 0)
#define DFTRACER_SEED 104723u
#endif
// clang-format on
#endif /* DFTRACER_CONFIG_H */