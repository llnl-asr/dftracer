namespace py = pybind11;
namespace dftracer {

void initialize(const char *log_file, const char *data_dirs, int process_id) {
  auto conf =
      dftracer::Singleton<dftracer::ConfigurationManager>::get_instance();
  DFTRACER_LOG_DEBUG("py.initialize", "");
  dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
      ProfilerStage::PROFILER_INIT, ProfileType::PROFILER_PY_APP, log_file,
      data_dirs, &process_id);
}

TimeResolution get_time() {
  DFTRACER_LOG_DEBUG("py.get_time", "");
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  if (dftracer_inst != nullptr)
    return dftracer_inst->get_time();
  else
    DFTRACER_LOG_DEBUG("py.get_time dftracer not initialized", "");
  return 0;
}

// Generic config lookup by the same key names used for the DFTRACER_* env
// vars (see constants.h), returned as the resolved (env-var-parsed) string
// value — not the raw ENV VAR name, its current value. Lets any Python-side
// caller (including external tool integrations like the PyTorch profiler or
// torch._dynamo hooks, which need e.g. TIME_METRIC to convert their own
// clock into dftracer's) query configuration without a bespoke binding per
// field.
std::string get_config(std::string key) {
  DFTRACER_LOG_DEBUG("py.get_config %s", key.c_str());
  auto conf = dftracer::Singleton<dftracer::ConfigurationManager>::get_instance();
  if (key == DFTRACER_TIME_METRIC) return to_string(conf->time_metric);
  if (key == DFTRACER_ENABLE) return conf->enable ? "1" : "0";
  if (key == DFTRACER_LOG_FILE) return conf->log_file;
  if (key == DFTRACER_DATA_DIR) return conf->data_dirs;
  if (key == DFTRACER_GOTCHA_PRIORITY) return std::to_string(conf->gotcha_priority);
  if (key == DFTRACER_SET_CORE_AFFINITY) return conf->core_affinity ? "1" : "0";
  if (key == DFTRACER_INC_METADATA) return "1";  // always included
  if (key == DFTRACER_DISABLE_POSIX) return conf->posix ? "0" : "1";
  if (key == DFTRACER_DISABLE_STDIO) return conf->stdio ? "0" : "1";
  if (key == DFTRACER_TRACE_COMPRESSION) return "1";  // always compressed
  if (key == DFTRACER_DISABLE_TIDS) return conf->tids ? "0" : "1";
  if (key == DFTRACER_ENABLE_AGGREGATION) return conf->aggregation_enable ? "1" : "0";
  if (key == DFTRACER_AGGREGATION_TYPE) return to_string(conf->aggregation_type);
  if (key == DFTRACER_BIND_SIGNALS) return conf->bind_signals ? "1" : "0";
  if (key == DFTRACER_WRITE_BUFFER_SIZE) return std::to_string(conf->write_buffer_size);
  if (key == DFTRACER_TRACE_INTERVAL_MS) return std::to_string(conf->trace_interval_ms);
  if (key == DFTRACER_LIBUV_THREADS) return std::to_string(conf->libuv_thread_count);
  DFTRACER_LOG_DEBUG("py.get_config unknown key %s", key.c_str());
  return "";
}

// A Python number or string as a JSON value (bool and int as integers).
static std::string py_json(py::handle v) {
  if (py::isinstance<py::bool_>(v))
    return std::to_string(static_cast<int>(v.cast<bool>()));
  if (py::isinstance<py::int_>(v)) {
    int overflow = 0;
    long long i = PyLong_AsLongLongAndOverflow(v.ptr(), &overflow);
    if (overflow == 0) return std::to_string(i);
    return std::to_string(PyLong_AsUnsignedLongLongMask(v.ptr()));
  }
  if (py::isinstance<py::float_>(v)) {
    char buf[32];
    snprintf(buf, sizeof(buf), "%.15g", v.cast<double>());
    return buf;
  }
  return json_quote(py::str(v).cast<std::string>().c_str());
}

// A list arg as JSON: [v, ...] or {sub: [v, ...], ...}.
static std::string py_list_json(py::handle values) {
  std::string json;
  if (py::isinstance<py::dict>(values)) {
    json = "{";
    for (auto sub : values.cast<py::dict>()) {
      if (json.size() > 1) json += ',';
      json += json_quote(py::str(sub.first).cast<std::string>().c_str());
      json += ':';
      json += py_list_json(sub.second);
    }
    return json + "}";
  }
  json = "[";
  for (auto v : values) {
    if (json.size() > 1) json += ',';
    json += py_json(v);
  }
  return json + "]";
}

void log_event(
    std::string name, std::string cat, TimeResolution start_time,
    TimeResolution duration,
    std::unordered_map<std::string, std::tuple<int, int64_t>> &int_args,
    std::unordered_map<std::string, std::tuple<int, std::string>> &string_args,
    std::unordered_map<std::string, std::tuple<int, double>> &float_args,
    std::unordered_map<EntityRelation, std::vector<EntityID>> &relations,
    py::dict list_args) {
  DFTRACER_LOG_DEBUG("py.log_event", "");
  auto args = new Metadata();
  for (auto item : int_args)
    args->insert_or_assign(item.first, std::get<1>(item.second),
                           convert(std::get<0>(item.second)));
  for (auto item : string_args)
    args->insert_or_assign(item.first, std::get<1>(item.second),
                           convert(std::get<0>(item.second)));
  for (auto item : float_args)
    args->insert_or_assign(item.first, std::get<1>(item.second),
                           convert(std::get<0>(item.second)));
  // {key: [v, ...]} -> args.key, {key: {sub: [v, ...]}} -> args.key.sub.
  for (auto item : list_args)
    args->insert_or_assign(py::str(item.first).cast<std::string>(),
                           RawJson(py_list_json(item.second)));
  // EntityRelation -> entity ids: args.relations.<relation> = [16-hex, ...].
  {
    char hex[DFT_ENTITY_HEX_LEN];
    std::string obj;
    for (auto &item : relations) {
      if (item.second.empty() || !dft_relation_is_event(item.first)) continue;
      obj += obj.empty() ? "{" : ",";
      obj += json_quote(dft_relation_name(item.first));
      obj += ":[";
      for (std::size_t i = 0; i < item.second.size(); ++i) {
        if (i) obj += ",";
        dft_entity_hex(item.second[i], hex);
        obj += json_quote(hex);
      }
      obj += "]";
    }
    if (!obj.empty())
      args->insert_or_assign(DFT_RELATIONS_ARG, RawJson(obj + "}"));
  }
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  // log() takes the args only when it writes the event.
  if (dftracer_inst == nullptr ||
      !dftracer_inst->log(name.c_str(), cat.c_str(),
                          TraceEventType::TRACE_TYPE_PYTHON, start_time,
                          duration, args))
    delete args;
}

// Entities: see dftracer_declare_entity in dftracer.h and
// core/common/entity.h. Ids are Python ints (EntityID).
EntityID declare_entity(std::string type, std::string key, EntityStore store,
                        std::string uri) {
  return dftracer_declare_entity(type.c_str(), key.c_str(), store, uri.c_str());
}

void declare_entity_type(std::string type, EntityRole role,
                         std::string description) {
  dftracer_declare_entity_type(type.c_str(), role, description.c_str());
}

void relate_entities(EntityRelation relation, EntityID subject,
                     EntityID object) {
  dftracer_relate_entities(relation, subject, object);
}

EntityID entity_hash(std::string type, std::string key) {
  char t[DFT_ENTITY_TYPE_LEN];
  dft_entity_sanitize(t, sizeof(t), type.c_str());
  return dft_entity_hash(t, key.c_str());
}

std::string entity_hex(EntityID id) {
  char hex[DFT_ENTITY_HEX_LEN];
  dft_entity_hex(id, hex);
  return std::string(hex);
}

// Without fields, a key/value metadata event. With fields ({name: value},
// values int, float, str, or lists as in log_event's list_args), a metadata
// record named `key` whose args are the fields.
void log_metadata_event(std::string key, std::string value, py::dict fields) {
  DFTRACER_LOG_DEBUG("py.log_metadata_event", "");
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  if (dftracer_inst == nullptr) {
    DFTRACER_LOG_DEBUG("py.log_metadata_event dftracer not initialized", "");
    return;
  }
  if (fields.empty()) {
    dftracer_inst->log_metadata(key.c_str(), value.c_str(),
                                TraceEventType::TRACE_TYPE_PYTHON);
    return;
  }
  auto record = new Metadata();
  for (auto item : fields) {
    std::string name = py::str(item.first);
    py::handle v = item.second;
    if (py::isinstance<py::list>(v) || py::isinstance<py::tuple>(v) ||
        py::isinstance<py::dict>(v))
      record->insert_or_assign(name, RawJson(py_list_json(v)));
    else if (py::isinstance<py::str>(v))
      record->insert_or_assign(name, v.cast<std::string>());
    else
      record->insert_or_assign(name, RawJson(py_json(v)));
  }
  dftracer_inst->log_record(key.c_str(), record,
                            TraceEventType::TRACE_TYPE_PYTHON);
}

void set_app_metadata_int(std::string key, int value) {
  DFTRACER_LOG_DEBUG("py.set_app_metadata_int", "");
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  if (dftracer_inst != nullptr)
    dftracer_inst->set_app_metadata(key.c_str(), (int64_t)value);
  else
    DFTRACER_LOG_DEBUG("py.set_app_metadata_int dftracer not initialized", "");
}

void set_app_metadata_string(std::string key, std::string value) {
  DFTRACER_LOG_DEBUG("py.set_app_metadata_string", "");
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  if (dftracer_inst != nullptr)
    dftracer_inst->set_app_metadata(key.c_str(), value.c_str());
  else
    DFTRACER_LOG_DEBUG("py.set_app_metadata_string dftracer not initialized",
                       "");
}

void mark_used(std::string name) {
  DFTRACER_LOG_DEBUG("py.mark_used", "");
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  if (dftracer_inst != nullptr)
    dftracer_inst->mark_used(name.c_str());
  else
    DFTRACER_LOG_DEBUG("py.mark_used dftracer not initialized", "");
}

int enter_event() {
  DFTRACER_LOG_DEBUG("py.enter_event", "");
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  return dftracer_inst->enter_event();
}

void exit_event() {
  DFTRACER_LOG_DEBUG("py.exit_event", "");
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_OTHER, ProfileType::PROFILER_PY_APP);
  dftracer_inst->exit_event();
}

void finalize() {
  DFTRACER_LOG_DEBUG("py.finalize", "");
  auto conf =
      dftracer::Singleton<dftracer::ConfigurationManager>::get_instance();
  // if (conf->init_type == ProfileInitType::PROFILER_INIT_FUNCTION) {
  auto dftracer_inst =
      dftracer::Singleton<dftracer::DFTracerCore>::get_instance(
          ProfilerStage::PROFILER_FINI, ProfileType::PROFILER_PY_APP);
  if (dftracer_inst != nullptr) {
    dftracer_inst->finalize();
  }
  //}
  DFTRACER_LOG_INFO("Finalized Py Binding", "");
}
}  // namespace dftracer