#!/usr/bin/env python3
"""Show how this DFTracer was configured and built.

Generated by CMake at configure time. Values and paths are baked in, and only
the Python standard library is used: nothing is imported from dftracer and no
MPI/HDF5/PAPI runtime has to be loaded.

Usage: dftracer_install_info [--json]
"""
import json
import sys
import textwrap

L = lambda s: [x for x in s.split(";") if x]
B = lambda v: bool(v)

# HDF5 is still version-gated: outside these ranges the wrappers are compiled
# out and nothing is traced. Mirrors the guards in core/brahma/hdf5.cpp; keep in
# sync. MPI is not gated this way (see mpi_slug below): the compat interfaces
# are read from brahma's installed headers at configure time.
HDF5_RANGES = [(100823, 100900), (101005, 101100), (101203, 101300), (101405, 101500)]


_IMPL_NAMES = {"openmpi": "OpenMPI", "mpich": "MPICH", "mvapich": "MVAPICH2",
               "craympich": "Cray MPICH"}


def family_name(slug):
    impl, major, minor = slug.rsplit("_", 2)
    return "%s %s.%s.x" % (_IMPL_NAMES.get(impl, impl), major, minor)


MPI_FAMILIES = L("@DFTRACER_BI_MPI_COMPAT_FAMILIES@")
MPIIO_FAMILIES = L("@DFTRACER_BI_MPIIO_COMPAT_FAMILIES@")
GENERATED_FROM = L("@DFTRACER_BI_MPI_GENERATED_FROM@")
COMPAT_TEXT = ", ".join(family_name(f) for f in MPI_FAMILIES) or "no implementation"
GENERATED_TEXT = ", ".join(
    "%s %s" % (_IMPL_NAMES.get(g.split()[0], g.split()[0]), g.split()[1])
    for g in GENERATED_FROM)

# What this DFTracer is written and verified against. Bounds come from the
# source, not from CI: CUDA from the CUPTI struct bands and the header list in
# core/function/cuda/intercept.cpp, rocprofiler-sdk from the API gates in
# core/function/hip/intercept.cpp. Keep in sync when those change.
SUPPORTED = {
    "mpi": "any MPI implementation and version traces the common MPI and "
           "MPI-IO calls. Calls beyond the common set are traced for " + COMPAT_TEXT
           + (" (generated from " + GENERATED_TEXT + ")" if GENERATED_TEXT else "")
           + ".",
    "hdf5": "1.8.23-1.8.x, 1.10.5-1.10.x, 1.12.3-1.12.x, 1.14.5-1.14.x. "
            "Other versions build but trace no HDF5 calls.",
    "cuda": "CUDA 10.1 through 13.x (headers checked: 10.1, 10.2, 11.1-11.8, "
            "12.2, 12.6, 12.9, 13.1). CUPTI record structs are chosen from the "
            "toolkit version.",
    "rocm": "rocprofiler-sdk, shipped with ROCm 6.2.0 and later; older ROCm "
            "has no rocprofiler-sdk. Code paths exist for API < 1.0.0 and >= 1.0.0.",
    "papi": "any PAPI that provides the preset events; no version gate.",
    "variorum": "any Variorum; no version gate.",
    "hwloc": "any hwloc; no version gate.",
}
CUDA_MIN, CUDA_MAX_MAJOR = (10, 1), 13


def cuda_status(v):
    try:
        t = tuple(int(x) for x in v.split(".")[:2])
    except ValueError:
        return "unknown"
    return "supported" if (t >= CUDA_MIN and t[0] <= CUDA_MAX_MAJOR) else \
        "outside the verified range (CUPTI struct selection may be wrong)"


def ver(n):  # brahma encodes major*100000 + minor*100 + patch
    return "%d.%d.%d" % (n // 100000, (n // 100) % 1000, n % 100) if n else ""


def fmt_ranges(rs):
    return ", ".join("%s-%s" % (ver(a), ver(b - 1)) for a, b in rs)


def in_ranges(n, rs):
    return any(a <= n < b for a, b in rs)


mpi_on, hdf5_on = B(@DFTRACER_BI_ON_MPI@), B(@DFTRACER_BI_ON_HDF5@)
mpi_n, hdf5_n = int("@DFTRACER_BI_BRAHMA_MPI_VERSION@"), int("@DFTRACER_BI_BRAHMA_HDF5_VERSION@")
# The compat interface compiled for this build, by implementation, major and
# minor; none if brahma has no compat interface for this MPI.
mpi_slug = ("%s_%d_%d" % ("@DFTRACER_BI_BRAHMA_MPI_IMPL@".lower(), mpi_n // 100000,
                          (mpi_n // 100) % 1000)) if mpi_n and "@DFTRACER_BI_BRAHMA_MPI_IMPL@" else ""
ev = L("@DFTRACER_BI_PAPI_EVENTS@".replace(",", ";"))
fit = int("@DFTRACER_BI_PAPI_FIT@" or 0)

INFO = {
    "version": "@DFTRACER_BI_VERSION@",
    "install_prefix": "@DFTRACER_BI_PREFIX@",
    "features": {
        # name: [requested at configure time, enabled in the build]
        "mpi": [@DFTRACER_BI_REQ_MPI@, @DFTRACER_BI_ON_MPI@],
        "hdf5": [@DFTRACER_BI_REQ_HDF5@, @DFTRACER_BI_ON_HDF5@],
        "function_tracing": [@DFTRACER_BI_REQ_FTRACING@, @DFTRACER_BI_ON_FTRACING@],
        "hip_tracing": [@DFTRACER_BI_REQ_HIP_TRACING@, @DFTRACER_BI_ON_HIP_TRACING@],
        "cuda_tracing": [@DFTRACER_BI_REQ_CUDA_TRACING@, @DFTRACER_BI_ON_CUDA_TRACING@],
        "papi_tracing": [@DFTRACER_BI_REQ_PAPI_TRACING@, @DFTRACER_BI_ON_PAPI_TRACING@],
        "variorum_power": [@DFTRACER_BI_REQ_VARIORUM@, @DFTRACER_BI_ON_VARIORUM@],
        "hwloc": [False, @DFTRACER_BI_ON_HWLOC@],
        "dynamic_detection": [@DFTRACER_BI_REQ_DYNAMIC_DETECTION@, @DFTRACER_BI_REQ_DYNAMIC_DETECTION@],
    },
    "mpi": {
        "implementation": "@DFTRACER_BI_MPI_IMPL@",
        "version": "@DFTRACER_BI_MPI_VERSION@",
        "c_compiler": "@DFTRACER_BI_MPI_C_COMPILER@",
        "cxx_compiler": "@DFTRACER_BI_MPI_CXX_COMPILER@",
        "include_dirs": L("@DFTRACER_BI_MPI_INCLUDE_DIRS@"),
        "libraries": L("@DFTRACER_BI_MPI_LIBRARIES@"),
        "brahma_implementation": "@DFTRACER_BI_BRAHMA_MPI_IMPL@",
        "brahma_enabled": @DFTRACER_BI_BRAHMA_MPI@,
        "brahma_version_number": mpi_n,
        "common_calls_traced": mpi_on and @DFTRACER_BI_BRAHMA_MPI@,
        "compat_interface": mpi_slug if mpi_slug in MPI_FAMILIES else "",
        "mpiio_compat_interface": mpi_slug if mpi_slug in MPIIO_FAMILIES else "",
        "compat_interfaces_available": MPI_FAMILIES,
        "generated_from": GENERATED_FROM,
    },
    "hdf5": {
        "version": "@DFTRACER_BI_HDF5_VERSION@",
        "include_dirs": L("@DFTRACER_BI_HDF5_INCLUDE_DIRS@"),
        "libraries": L("@DFTRACER_BI_HDF5_LIBRARIES@"),
        "brahma_enabled": @DFTRACER_BI_BRAHMA_HDF5@,
        "brahma_version_number": hdf5_n,
        "supported_ranges": fmt_ranges(HDF5_RANGES),
        "calls_traced": hdf5_on and @DFTRACER_BI_BRAHMA_HDF5@ and in_ranges(hdf5_n, HDF5_RANGES),
    },
    "papi": {
        "include_dirs": L("@DFTRACER_BI_PAPI_INCLUDE_DIRS@"),
        "libraries": L("@DFTRACER_BI_PAPI_LIBRARIES@"),
        "detected_events": "@DFTRACER_BI_PAPI_EVENTS@",
        "detected_count": len(ev),
        "hw_counters": int("@DFTRACER_BI_PAPI_HW@" or 0),
        "fitting_counters": fit,
        "multiplexed": 0 < fit < len(ev),
    },
    "gpu": {
        "rocprofiler_sdk_version": "@DFTRACER_BI_ROCPROFILER_VERSION@",
        "rocprofiler_sdk_include": "@DFTRACER_BI_ROCPROFILER_INCLUDE@",
        "cuda_version": "@DFTRACER_BI_CUDA_VERSION@",
        "cupti_include": "@DFTRACER_BI_CUPTI_INCLUDE@",
        "cuda_status": "",
    },
    "supported_versions": SUPPORTED,
    "variorum": {
        "include_dirs": L("@DFTRACER_BI_VARIORUM_INCLUDE_DIRS@"),
        "libraries": L("@DFTRACER_BI_VARIORUM_LIBRARIES@"),
    },
    "hwloc": {
        "include_dirs": L("@DFTRACER_BI_HWLOC_INCLUDE_DIRS@"),
        "libraries": L("@DFTRACER_BI_HWLOC_LIBRARIES@"),
    },
    "brahma": {
        "dir": "@DFTRACER_BI_BRAHMA_DIR@",
        "include_dirs": L("@DFTRACER_BI_BRAHMA_INCLUDE_DIRS@"),
    },
    "producer_consumer_ring": {
        "blocks": int("@DFTRACER_BI_PC_RING_BLOCKS@" or 0),
        "block_size": int("@DFTRACER_BI_PC_RING_BLOCK_SIZE@" or 0),
    },
    "toolchain": {
        "build_type": "@DFTRACER_BI_BUILD_TYPE@",
        "cmake": "@DFTRACER_BI_CMAKE_VERSION@",
        "c_compiler": "@DFTRACER_BI_C_COMPILER@",
        "c_compiler_id": "@DFTRACER_BI_C_COMPILER_ID@",
        "cxx_compiler": "@DFTRACER_BI_CXX_COMPILER@",
        "cxx_compiler_id": "@DFTRACER_BI_CXX_COMPILER_ID@",
        "libc": "@DFTRACER_BI_LIBC@",
    },
}

for _k in ("rocprofiler_sdk_version", "cuda_version"):
    # unset versions render as ".."; show them as absent
    if not INFO["gpu"][_k].strip("."):
        INFO["gpu"][_k] = ""
if INFO["gpu"]["cuda_version"]:
    INFO["gpu"]["cuda_status"] = cuda_status(INFO["gpu"]["cuda_version"])

OK, NO = "✔", "✘"


def row(k, v):
    if isinstance(v, list):
        v = ", ".join(v)
    return "  %-22s: %s" % (k, v if v not in ("", None) else "-")


def pretty(i):
    out = ["DFTracer %s  (prefix %s)" % (i["version"], i["install_prefix"]), "",
           "Features   (requested -> enabled)"]
    for k, (req, on) in i["features"].items():
        warn = "   <-- requested but NOT enabled" if req and not on else ""
        out.append("  %s %-18s %s%s" % (OK if on else NO, k, "ON" if on else "off", warn))
    m = i["mpi"]
    out += ["", "MPI"]
    out += [row(k, v) for k, v in m.items()
            if k not in ("common_calls_traced", "compat_interface", "mpiio_compat_interface",
                         "compat_interfaces_available", "generated_from")]
    on = i["features"]["mpi"][1]
    out.append("  %-22s: %s" % ("common calls traced", OK if m["common_calls_traced"] else NO))
    if on:
        out.append(row("compat calls traced", m["compat_interface"] or
                       "none (no compat interface for this MPI; common calls only)"))
        out.append(row("MPI-IO compat calls", m["mpiio_compat_interface"] or "none"))
    out.append(row("compat interfaces for", ", ".join(family_name(f) for f in m["compat_interfaces_available"])))
    out.append(row("generated from", ", ".join(m["generated_from"])))
    h = i["hdf5"]
    out += ["", "HDF5"]
    out += [row(k, v) for k, v in h.items() if k not in ("calls_traced", "supported_ranges")]
    out.append(row("supported versions", h["supported_ranges"]))
    out.append("  %-22s: %s%s" % ("calls traced", OK if h["calls_traced"] else NO,
        "" if h["calls_traced"] or not i["features"]["hdf5"][1] else
        "   (version outside supported ranges: wrappers compiled out)"))
    out += ["", "Supported versions"]
    for k, v in i["supported_versions"].items():
        out.append(textwrap.fill(v, 78, initial_indent="  %-9s " % k,
                                 subsequent_indent=" " * 12))
    for sec, title in (("papi", "PAPI"), ("gpu", "GPU"), ("variorum", "Variorum"),
                       ("hwloc", "hwloc"), ("brahma", "brahma"),
                       ("producer_consumer_ring", "Producer/consumer ring"),
                       ("toolchain", "Toolchain")):
        out += ["", title] + [row(k, v) for k, v in i[sec].items()]
    return "\n".join(out)


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    print(json.dumps(INFO, indent=2) if "--json" in argv else pretty(INFO))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
